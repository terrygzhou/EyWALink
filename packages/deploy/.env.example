# ────────────────────────────────────────────────────────────────────────
# EyWALink Private AI Reference Implementation — environment template
# Copy to .env and customize for your deployment.
#   cp .env.example .env
#   docker compose up -d
#   docker compose --profile fallback up -d   # enable vLLM + Ollama fallbacks
# ────────────────────────────────────────────────────────────────────────

# ─── Model Configuration ────────────────────────────────────────────────
# Primary model served by SGLang.
PRIMARY_MODEL=nvidia/Qwen3.6-27B-NVFP4
# Fallback models: vLLM (speculative decoding) then Ollama (CPU-friendly).
FALLBACK_VLLM_MODEL=nvidia/Qwen3.6-27B-Text-NVFP4-MTP
FALLBACK_OLLAMA_MODEL=qwen3:8b
# Order of the fallback chain (comma-separated provider names).
FALLBACK_CHAIN=sglang,vllm,ollama
CONTEXT_LENGTH=128000

# ─── GPU / VRAM Management ──────────────────────────────────────────────
# SGLang: fraction of VRAM reserved for KV cache (leave headroom for
# host/API overhead). Lower = safer on shared GPUs.
MEM_FRACTION_STATIC=0.89
# Pin specific GPUs per service. Examples: "0", "1", "0,1".
SGLANG_GPU=all
SGLANG_GPU_COUNT=all
VLLM_GPU=all
VLLM_GPU_COUNT=all
# vLLM: fraction of GPU memory the engine may use.
VLLM_GPU_MEM_UTIL=0.90

# ─── Gateway ────────────────────────────────────────────────────────────
MAX_CONCURRENT=8
LOG_LEVEL=INFO
GATEWAY_MEM_LIMIT=512m

# ─── Ports ──────────────────────────────────────────────────────────────
GATEWAY_PORT=8000
SGLANG_PORT=8080
VLLM_PORT=8001
OLLAMA_PORT=11434
QDRANT_PORT=6333
QDRANT_API_PORT=6334
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
PHOENIX_PORT=6007
LOKI_PORT=3101

# ─── Grafana ────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
