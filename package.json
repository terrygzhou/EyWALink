{
  "name": "eywalink-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "EyWALink — Zero lock-in, budget-friendly enterprise private AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/terrygzhou/EyWALink.git"
  },
  "homepage": "https://www.eywalink.org",
  "bugs": {
    "url": "https://github.com/terrygzhou/EyWALink/issues"
  },
  "license": "MIT",
  "author": "EyWALink <info@eywalink.org>",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "clean": "pnpm -r clean && find . -name node_modules -type d -exec rm -rf {} +",
    "precommit": "pre-commit run --hook-stage pre-commit --files $(git diff --cached --name-only --diff-filter ACM -- '*.ts' '*.tsx' '*.js' '*.py' '*.md' '*.yaml' '*.json')"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  }
}
